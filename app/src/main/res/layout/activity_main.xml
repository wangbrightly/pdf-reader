<?xml version="1.0" encoding="utf-8"?>
<!--
    最简单方案：LinearLayout 竖排 = 按钮 + 三个设置滑杆（字号/行距/边距，系统自带 SeekBar，
    不引入额外 UI 库）+ 进度条 + ScrollView 包内容区。

    2026-08-18 美化：
    - 状态栏避让改在 MainActivity.onCreate 里用 ViewCompat.setOnApplyWindowInsetsListener
      对 rootLayout 动态加 padding——试过 XML 里写 android:fitsSystemWindows="true"，
      真机截图验证发现在这台设备（安卓走 edge-to-edge 强制内容延伸到状态栏后面）上不生效，
      按钮顶部还是被状态栏文字盖住，改用现在这种主动读 WindowInsets 的写法才是真的避开。
    - 根布局加了整体内外边距，按钮和设置区之间、设置区内部三组滑杆之间都加了间距，
      不再是贴在一起的一坨。
    - 三个滑杆包进一个带浅色背景的分组容器，视觉上跟"打开 PDF"按钮和下面的内容区分开，
      不需要额外 UI 库，纯靠 background drawable + padding。

    2026-08-18 补：设置面板可折叠。
    用户反馈"这一页的菜单都在屏幕上，把菜单隐藏起来，提高阅读体验"——settingsPanel
    整块（三个滑杆）现在可以收起，读文档时不占屏幕；toggleSettingsButton 常驻在
    "打开 PDF"按钮右边（横排，不额外占一整行高度），随时能展开/收起，"打开 PDF"
    按钮本身不折叠（换文件随时要用，且本身占地方不大）。折叠/展开的具体触发逻辑
    （PDF 加载成功后自动收起）在 MainActivity.render() 里。

    2026-08-18 补：加了 tocButton（目录）。
    放在 openButton 和 toggleSettingsButton 之间——跟"打开 PDF"一样是"内容导航"类
    操作（不是设置类），紧挨着放符合就近原则；样式沿用 toggleSettingsButton（同样
    wrap_content 宽度、不额外占地方，横排不新增一整行高度）。没有大纲的 PDF（很
    常见）这个按钮会被禁用（isEnabled=false，看起来变灰不可点），而不是隐藏——
    理由见 MainActivity 类注释"目录"一节：按钮位置固定不随文档切换而跳动，禁用态
    本身就足够说明"这份文档没有目录"，不需要再额外弹提示。

    2026-08-18 补：三个滑杆组之间的间距，8dp → 20dp → 40dp（用户试过 20dp 后要求
    再翻一倍）。用户反馈"3 个菜单的行距太近，不方便选择滑动拉杆"——原来 8dp 时相邻
    两个 SeekBar 的可触摸区域挨得太近，手指容易碰到旁边那一条，误触/误拖。只调了
    组间距（label 的 marginTop），组内 label 和自己的 SeekBar 之间紧挨着不变，视觉上
    "字号"这行和它下面的滑杆是一体的，跟"行距"那组隔开一段明显距离，一眼能分清是
    三组独立的东西。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/openButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:text="@string/open_pdf"
            android:textSize="16sp" />

        <Button
            android:id="@+id/tocButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:enabled="false"
            android:minHeight="52dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:text="@string/toc_button"
            android:textSize="14sp" />

        <Button
            android:id="@+id/toggleSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="52dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:text="@string/settings_toggle_hide"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_settings_panel"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/fontSizeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/fontSizeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="12"
            android:max="32"
            android:progress="16"
            android:thumb="@drawable/seekbar_thumb_large" />

        <TextView
            android:id="@+id/lineSpacingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp" />

        <SeekBar
            android:id="@+id/lineSpacingSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="10"
            android:progress="2"
            android:thumb="@drawable/seekbar_thumb_large" />

        <TextView
            android:id="@+id/paddingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp" />

        <SeekBar
            android:id="@+id/paddingSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="8"
            android:max="32"
            android:progress="16"
            android:thumb="@drawable/seekbar_thumb_large" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!--
        contentContainer 取代了原来单个 TextView 的位置：图片浮动展示这个增量要求
        "图片穿插在大致对应的文字段落之间"，单个 TextView 塞一整段纯文字做不到——
        改成一个纵向 LinearLayout，按顺序动态塞"文字段落 TextView"和"图片 ImageView"
        两种子 View（见 MainActivity.renderBlocks）。padding 从原来 contentText 上
        移到这里，保持"内容离屏幕边缘有一圈留白"的视觉效果不变。
        注意：MainActivity 的阅读进度滚动比例计算（computeScrollRatio /
        restoreScrollRatioIfNeeded）依赖 contentScrollView.getChildAt(0) 拿到"内容区
        总高度"，这两个方法本身不关心子 View 是 TextView 还是 LinearLayout，改动前后
        行为兼容，不需要跟着改。
    -->
    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />

    </ScrollView>

</LinearLayout>
