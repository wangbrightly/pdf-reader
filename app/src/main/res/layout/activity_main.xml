<?xml version="1.0" encoding="utf-8"?>
<!--
    最简单方案：LinearLayout 竖排 = 按钮 + 三个设置滑杆（字号/行距/边距，系统自带 SeekBar，
    不引入额外 UI 库）+ 进度条 + ScrollView 包内容区。

    2026-08-18 美化：
    - 状态栏避让改在 MainActivity.onCreate 里用 ViewCompat.setOnApplyWindowInsetsListener
      对 rootLayout 动态加 padding——试过 XML 里写 android:fitsSystemWindows="true"，
      真机截图验证发现在这台设备（安卓走 edge-to-edge 强制内容延伸到状态栏后面）上不生效，
      按钮顶部还是被状态栏文字盖住，改用现在这种主动读 WindowInsets 的写法才是真的避开。
      2026-08-19 补：同样的机制也覆盖了底部导航栏（三键导航条比手势条高，会挡住内容
      最后一行）——见 MainActivity.applySystemBarInsetsAsPadding。
    - 根布局加了整体内外边距，按钮和设置区之间、设置区内部三组滑杆之间都加了间距，
      不再是贴在一起的一坨。
    - 三个滑杆包进一个带浅色背景的分组容器，视觉上跟"打开 PDF"按钮和下面的内容区分开，
      不需要额外 UI 库，纯靠 background drawable + padding。

    2026-08-18 补：设置面板可折叠。
    用户反馈"这一页的菜单都在屏幕上，把菜单隐藏起来，提高阅读体验"——settingsPanel
    整块（三个滑杆）现在可以收起，读文档时不占屏幕；toggleSettingsButton 常驻在
    按钮行最右边（横排，不额外占一整行高度），随时能展开/收起，"打开 PDF"
    按钮本身不折叠（换文件随时要用，且本身占地方不大）。折叠/展开的具体触发逻辑
    （PDF 加载成功后自动收起）在 MainActivity.render() 里；2026-08-19 补：冷启动
    还没打开任何文档时也默认收起（用户反馈"设置菜单默认不展开"），见 onCreate
    里直接调用 collapseSettingsPanel。

    2026-08-18 补：加了 tocButton（目录）。
    跟"打开 PDF"一样是"内容导航"类操作（不是设置类）。样式沿用 toggleSettingsButton
    （同样 wrap_content 宽度、不额外占地方，横排不新增一整行高度）。没有大纲的 PDF
    （很常见）这个按钮会被禁用（isEnabled=false，看起来变灰不可点），而不是隐藏——
    理由见 MainActivity 类注释"目录"一节：按钮位置固定不随文档切换而跳动，禁用态
    本身就足够说明"这份文档没有目录"，不需要再额外弹提示。
    2026-08-19 补：挪到按钮行最左边（用户反馈"目录放到左侧"）——原来在 openButton
    和 toggleSettingsButton 之间，现在排在 openButton 前面，openButton 的
    layout_weight="1" 跟着从第一个挪到第二个位置，仍然占满剩余空间。

    2026-08-18 补：三个滑杆组之间的间距，8dp → 20dp → 40dp（用户试过 20dp 后要求
    再翻一倍）。用户反馈"3 个菜单的行距太近，不方便选择滑动拉杆"——原来 8dp 时相邻
    两个 SeekBar 的可触摸区域挨得太近，手指容易碰到旁边那一条，误触/误拖。只调了
    组间距（label 的 marginTop），组内 label 和自己的 SeekBar 之间紧挨着不变，视觉上
    "字号"这行和它下面的滑杆是一体的，跟"行距"那组隔开一段明显距离，一眼能分清是
    三组独立的东西。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!--
        2026-08-26 用户反馈"三个菜单上面增加文件名"——冷启动/没打开过文档时
        没有文件名可显示，默认收起（gone），MainActivity.loadPdf 里一拿到 Uri
        就设置文本并显示，不用等文档真正解析成功（哪怕最后打开失败，用户也想
        知道刚才点的是哪个文件）。
        单行 + 首部省略号——文件名比按钮行宽是常态，省略中间/末尾会看不出扩展名，
        省略号放最前面能保留"最像是这份文档"的信息（通常是文件名末尾更有辨识度，
        比如"XX年报-终稿.pdf"，开头往往是重复的项目代号）。

        同日再改：用户反馈"不够醒目"+"上面空白太多"——文字从半透明浅灰
        （#88888888）+13sp 改成 @color/label_text_emphasis（87% 不透明黑）+15sp+
        加粗；`rootLayout` 的 `paddingTop` 从 16dp 降到 8dp（跟状态栏之间已经有
        `applySystemBarInsetsAsPadding` 动态加的系统栏安全间距，这 16dp 是额外
        叠加的固定留白，缩小它不会导致内容被状态栏盖住）。

        同日再改：用户反馈"文件名过长只看到后半部分"——原来 `ellipsize="start"`
        省略号放最前面只保留得了后半截，前面看不全。改成安卓标准的跑马灯滚动
        （`ellipsize="marquee"` + `marqueeRepeatLimit="marquee_forever"`），
        自动来回滚动展示完整文件名，不用二选一截哪一半。`focusable`+
        `focusableInTouchMode` 是跑马灯生效的必要条件（不加的话这个 TextView
        领不到焦点，marquee 动画不会启动）；另外还要在 Kotlin 里手动把
        `isSelected` 设成 true——marquee 是"选中态"才滚动的效果，纯靠 XML
        属性不会自己动，这是安卓 TextView 跑马灯最常踩的坑，见
        MainActivity.onCreate/loadPdf。
    -->
    <TextView
        android:id="@+id/fileNameLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:singleLine="true"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/label_text_emphasis"
        android:visibility="gone" />

    <!--
        2026-08-26 用户反馈"文件名、三个菜单设置成同右侧滑杆一样是隐藏的"——加了
        id 方便 MainActivity.updateChromeVisibility 控制这一整行的显隐，跟
        fileNameLabel、pageScrubberThumb 一起纳入"点击屏幕中央呼出/收起"的沉浸
        模式，见 MainActivity.setupCenterTapToggleScrubber KDoc。
    -->
    <LinearLayout
        android:id="@+id/topButtonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!--
            2026-08-26 美化：三个按钮统一去掉 AppCompat 默认的系统阴影
            （stateListAnimator="@null"，那种默认阴影跟这个 App 其它地方"扁平、
            半透明圆角"的视觉语言不搭），换上 bg_button_primary/secondary.xml
            自定义背景，见 colors.xml 完整背景。
        -->
        <Button
            android:id="@+id/tocButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_secondary"
            android:enabled="false"
            android:minHeight="52dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:stateListAnimator="@null"
            android:text="@string/toc_button"
            android:textSize="14sp" />

        <Button
            android:id="@+id/openButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:minHeight="52dp"
            android:stateListAnimator="@null"
            android:text="@string/open_pdf"
            android:textColor="@color/button_primary_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/toggleSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_secondary"
            android:minHeight="52dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:stateListAnimator="@null"
            android:text="@string/settings_toggle_hide"
            android:textSize="14sp" />

    </LinearLayout>

    <!--
        2026-08-26 用户反馈"点击屏幕中央，四个设置滑杆没有隐藏"——纳入
        MainActivity.updateChromeVisibility 统一控制的沉浸模式（跟 topButtonRow/
        fileNameLabel/pageScrubberThumb 一起），初始态明确写 gone，跟 Kotlin 里
        settingsPanelExpanded 默认 false 保持一致，不依赖 collapseSettingsPanel()
        在 onCreate 里跑一次才收起（它现在只是个状态已经是收起时的空操作）。
    -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_settings_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!--
            2026-08-26 用户反馈"标签不够醒目，标签和滑杆用不同颜色，参照游戏图"——
            4 个标签统一加粗、换成 @color/label_text_emphasis（87% 不透明黑），
            跟滑杆本身的藏青蓝强调色（seekbar_thumb_knob.xml 等）形成对比，呼应
            参考图里"黑色加粗标签 + 鲜艳颜色滑杆"两者分明的层次。
        -->
        <TextView
            android:id="@+id/fontSizeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/label_text_emphasis" />

        <SeekBar
            android:id="@+id/fontSizeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="12"
            android:max="32"
            android:progress="16"
            android:progressDrawable="@drawable/seekbar_track_thick"
            android:thumb="@drawable/seekbar_thumb_knob" />

        <TextView
            android:id="@+id/lineSpacingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/label_text_emphasis" />

        <SeekBar
            android:id="@+id/lineSpacingSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="10"
            android:progress="2"
            android:progressDrawable="@drawable/seekbar_track_thick_purple"
            android:thumb="@drawable/seekbar_thumb_knob_purple" />

        <TextView
            android:id="@+id/paddingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/label_text_emphasis" />

        <SeekBar
            android:id="@+id/paddingSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="8"
            android:max="32"
            android:progress="16"
            android:progressDrawable="@drawable/seekbar_track_thick_coral"
            android:thumb="@drawable/seekbar_thumb_knob_coral" />

        <TextView
            android:id="@+id/blockSpacingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/label_text_emphasis" />

        <SeekBar
            android:id="@+id/blockSpacingSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="32"
            android:progress="12"
            android:progressDrawable="@drawable/seekbar_track_thick_teal"
            android:thumb="@drawable/seekbar_thumb_knob_teal" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!--
        2026-08-20：contentScrollView（ScrollView 包 contentContainer LinearLayout）
        换成 RecyclerView——文字/图片真正按需加载（RecyclerView 窗口式重构，见
        /Users/mac/.claude/plans/fizzy-snuggling-cloud.md），条目粒度=页，只有屏幕
        附近的页会真的创建 View/抽取内容，翻远的自动回收，这是根治超大文档
        （NOTES.md #21，4232 页会 OutOfMemoryError）必需的基础设施，普通 ScrollView+
        LinearLayout 做不到"翻远的内容自动释放"这件事。
        LayoutManager（LinearLayoutManager，纵向）在 MainActivity.onCreate 里设置，
        不在 XML 里写死——阅读进度（当前第几页）、目录跳转都要拿到这个 LayoutManager
        的引用，放在代码里更方便复用同一个实例。
        padding 从原来 contentContainer 移到这里，"边距"设置项现在直接改
        recyclerView 自己的 padding。

        2026-08-20 同日再加：用户要求"屏幕右侧加一根可拖拽的翻页滑条"（跟很多阅读器
        App 一样的快速翻页手柄）。外面套一层 FrameLayout，把 recyclerView 和
        pageScrubberTrack/pageScrubberThumb/pageScrubberLabel 叠在一起——具体的拖拽
        手势、页码换算逻辑在 MainActivity.setupPageScrubber，这里只是布局骨架。
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp" />

        <!--
            触摸靶区：贴着屏幕最右边一条竖直窄条，比视觉上看到的滑条（thumb）宽得多——
            手指不需要精确点在那个小圆点上，靠近右边缘任意位置按下/拖动都能触发，是
            常见阅读器快速翻页手柄的标准做法。本身透明，不画任何东西。
        -->
        <!--
            2026-08-26：跟 pageScrubberThumb 同一次改动——默认 enabled="false"，
            手柄隐藏时这条触摸靶区也一起禁用，不留"看不见但摸得到"的死角，见
            MainActivity.updateScrubberVisibility KDoc。
        -->
        <View
            android:id="@+id/pageScrubberTrack"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:enabled="false" />

        <!--
            视觉上真正看到的滑条手柄，纵向位置由代码算出的 translationY 决定。
            2026-08-26 用户反馈"放到最右侧"——marginEnd 从 6dp 改成 0dp，贴着这个
            FrameLayout 自己的右边缘。**注意**：这个 FrameLayout 外面还套着
            rootLayout 的 android:paddingHorizontal="16dp"（整个内容列的左右
            边距，见文件顶部类注释），所以手柄贴的是"内容列的右边缘"，不是屏幕
            物理右边缘——真要贴到屏幕物理边缘，需要把手柄挪出这层 padding（比如
            用负 margin 抵消，或者重新设计视图层级），这次只做了"这个容器内能做到
            的最右"，如果不够右需要用户确认要不要动那层更大范围的 padding。
        -->
        <!--
            2026-08-26 用户反馈"改为隐藏式，点击中央才显示"——默认 gone，
            显隐完全交给 MainActivity.updateScrubberVisibility 控制（见该函数
            KDoc），这里只是给"Kotlin 代码运行之前"这段时间定一个正确的初始态，
            不依赖 render() 一定先跑过一次才不出现"冷启动闪现一下手柄"的问题。

            同日再改：用户参照游戏音量滑杆截图要求"旋钮质感"——尺寸从 6dp×36dp
            的窄条改成 32dp×32dp 的圆形（配合 page_scrubber_thumb_knob.xml），
            marginEnd 仍是 0dp（贴内容列右边缘，见上面那条注释），moveScrubberThumbTo
            用的是 view.height 实时读取，换尺寸不需要改任何拖拽定位的计算代码。
        -->
        <View
            android:id="@+id/pageScrubberThumb"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="0dp"
            android:background="@drawable/page_scrubber_thumb_knob"
            android:visibility="gone" />

        <!-- 拖拽过程中显示"第 X 页 / 共 Y 页"，松手后隐藏，见类注释。 -->
        <TextView
            android:id="@+id/pageScrubberLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginEnd="52dp"
            android:background="@drawable/bg_settings_panel"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
