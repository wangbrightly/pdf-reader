<?xml version="1.0" encoding="utf-8"?>
<!--
    2026-08-26：用户参照一张游戏音量滑杆截图反馈"圆点太素，想要旋钮质感"——原来的
    seekbar_thumb_large.xml 是纯色正圆，改成这个 VectorDrawable：实心圆 + 一圈半透明
    白色描边（暗示"这是立体的实体旋钮"，不是纯装饰）+ 中间三条竖线抓握纹理（暗示
    "左右拖动"，跟这四个滑杆本身是横向拖动一致）。

    用 VectorDrawable 而不是 layer-list 叠 shape——layer-list 的 <item> 定位靠
    left/right/top/bottom 这几个"到边界的内边距"，没法精确摆出"三条等间距竖线
    居中排列"这种效果，vector 直接用坐标写 pathData 简单很多。

    viewport 36x36 对应原来 seekbar_thumb_large.xml 的 36dp 尺寸，SeekBar 的拉杆
    大小/触摸热区跟之前一致，不用改任何布局或 Kotlin 里的坐标换算代码。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="36"
    android:viewportHeight="36">

    <!-- 实心圆主体 -->
    <path
        android:fillColor="@color/button_primary_bg"
        android:pathData="M2,18 A16,16 0 1,1 34,18 A16,16 0 1,1 2,18 Z" />

    <!-- 外圈描边，增加立体感 -->
    <path
        android:strokeColor="@color/button_thumb_ring"
        android:strokeWidth="2"
        android:pathData="M2,18 A16,16 0 1,1 34,18 A16,16 0 1,1 2,18 Z" />

    <!-- 中间三条竖线抓握纹理 -->
    <path android:fillColor="@color/button_thumb_grip" android:pathData="M13,12 H15 V24 H13 Z" />
    <path android:fillColor="@color/button_thumb_grip" android:pathData="M17,12 H19 V24 H17 Z" />
    <path android:fillColor="@color/button_thumb_grip" android:pathData="M21,12 H23 V24 H21 Z" />

</vector>
