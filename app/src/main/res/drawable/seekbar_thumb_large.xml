<?xml version="1.0" encoding="utf-8"?>
<!--
    2026-08-18：用户反馈"三个滑条的拉杆放大几倍，方便手指拖动"——系统默认的 SeekBar
    拉杆偏小，手指容易点不准。用一个纯色圆形 drawable 显式指定尺寸（<size> 节点，
    SeekBar 会按这个当拉杆的实际大小/触摸热区），颜色跟主题的 colorControlActivated
    保持一致，不额外硬编码颜色，深色/浅色模式都跟随主题自动适配。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/colorControlActivated" />
    <size
        android:width="36dp"
        android:height="36dp" />
</shape>
